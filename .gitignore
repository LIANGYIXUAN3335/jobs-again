.venv/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store
data/*.db-wal
data/*.db-shm
data/*.db
data/*.sqlite
data/*.sqlite3
data/*_backup.json
data/mail_label_*.json
data/logs/

# tailoring artifacts are personal/generated, not source
/output/

# local snapshots and generated research batches
*.bak-*
scratch_priors/*.json
scratch_priors/*.md

# raw LinkedIn guest-scrape output — regenerated each nightly run
scratch_priors/linkedin_enriched_archive/

# local runtime caches and recovery snapshots
.backups/

# LOCAL SECRETS — never commit (Anthropic API key for AI autofill)
secrets.yaml
secrets/

# Defence in depth (added 2026-08-10, security audit). The rules above are
# path-specific; these catch the same kinds of file if one is ever written
# somewhere new. The *.example.yaml templates stay tracked on purpose.
.env
.env.*
*.db
*.sqlite
*.sqlite3
**/token*.json
**/*credential*.json
**/*client_secret*.json
*.pem
*.p12

# untracked scratch working files (only *.json / *.md were covered before)
scratch_priors/_*
