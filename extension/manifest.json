{
  "manifest_version": 3,
  "name": "JobScan Apply Helper",
  "version": "0.1.0",
  "description": "Pre-fills Greenhouse/Lever/Ashby/Workday application forms with your profile and the tailored résumé from your local JobScan. Stops before submit.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "http://127.0.0.1:8787/*",
    "http://localhost:8787/*",
    "*://job-boards.greenhouse.io/*",
    "*://boards.greenhouse.io/*",
    "*://*.greenhouse.io/*",
    "*://jobs.ashbyhq.com/*",
    "*://jobs.lever.co/*",
    "*://jobs.eu.lever.co/*",
    "*://*.myworkdayjobs.com/*",
    "*://www.google.com/about/careers/*",
    "*://careers.google.com/*",
    "*://*.careers.microsoft.com/*",
    "*://jobs.smartrecruiters.com/*",
    "*://jobs.apple.com/*",
    "*://jobs.careers.microsoft.com/*",
    "*://www.tesla.com/careers/*",
    "*://www.atlassian.com/*",
    "*://wise.jobs/*",
    "*://careers.linkedin.com/*",
    "*://www.circle.com/careers/*",
    "*://www.hashicorp.com/careers/*",
    "*://retool.com/careers/*",
    "*://www.deel.com/careers/*",
    "*://jobs.deel.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "JobScan Apply Helper" },
  "content_scripts": [
    {
      "matches": [
        "*://job-boards.greenhouse.io/*",
        "*://boards.greenhouse.io/*",
        "*://jobs.ashbyhq.com/*",
        "*://jobs.lever.co/*",
        "*://jobs.eu.lever.co/*",
        "*://*.myworkdayjobs.com/*",
        "*://www.google.com/about/careers/*",
        "*://careers.google.com/*",
        "*://*.careers.microsoft.com/*",
        "*://jobs.smartrecruiters.com/*",
        "*://jobs.apple.com/*",
        "*://jobs.careers.microsoft.com/*",
        "*://www.tesla.com/careers/*",
        "*://www.atlassian.com/*",
        "*://wise.jobs/*",
        "*://careers.linkedin.com/*",
        "*://www.circle.com/careers/*",
        "*://www.hashicorp.com/careers/*",
        "*://retool.com/careers/*",
        "*://www.deel.com/careers/*",
        "*://jobs.deel.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
