{
  "manifest_version": 3,
  "name": "JobScan Apply Helper",
  "version": "0.5.13",
  "description": "Fill, independently review, repair, and submit one authorized application; verify employer confirmation.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8787/*",
    "http://localhost:8787/*",
    "http://localhost:8788/*",
    "http://127.0.0.1:8788/*",
    "*://job-boards.greenhouse.io/*",
    "*://boards.greenhouse.io/*",
    "*://*.greenhouse.io/*",
    "*://jobs.ashbyhq.com/*",
    "*://jobs.lever.co/*",
    "*://jobs.eu.lever.co/*",
    "*://*.myworkdayjobs.com/*",
    "*://www.google.com/about/careers/*",
    "*://careers.google.com/*",
    "*://*.careers.microsoft.com/*",
    "*://jobs.smartrecruiters.com/*",
    "*://jobs.apple.com/*",
    "*://jobs.careers.microsoft.com/*",
    "*://www.tesla.com/careers/*",
    "*://www.atlassian.com/*",
    "*://wise.jobs/*",
    "*://careers.linkedin.com/*",
    "*://www.circle.com/careers/*",
    "*://www.hashicorp.com/careers/*",
    "*://retool.com/careers/*",
    "*://www.deel.com/careers/*",
    "*://jobs.deel.com/*",
    "*://bloomberg.avature.net/*",
    "*://ats.rippling.com/*",
    "*://*.lever.co/*",
    "*://*.ashbyhq.com/*",
    "*://*.workable.com/*",
    "*://*.jobvite.com/*",
    "*://*.icims.com/*",
    "*://*.bamboohr.com/*",
    "*://*.smartrecruiters.com/*",
    "*://*.paylocity.com/*",
    "*://*.dover.com/*",
    "*://*.rippling.com/*",
    "*://*.avature.net/*",
    "*://*.recruitee.com/*",
    "*://*.teamtailor.com/*",
    "*://*.breezy.hr/*",
    "*://*.pinpointhq.com/*",
    "*://*.gem.com/*",
    "*://*.eightfold.ai/*",
    "*://*.oraclecloud.com/*",
    "*://*.taleo.net/*",
    "*://*.successfactors.com/*",
    "*://*.workdayjobs.com/*",
    "*://careers.withwaymo.com/*",
    "*://www.workato.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["runner.html"],
      "matches": ["http://127.0.0.1:8787/*", "http://localhost:8787/*"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "JobScan Apply Helper"
  },
  "content_scripts": [
    {
      "matches": [
        "*://job-boards.greenhouse.io/*",
        "*://boards.greenhouse.io/*",
        "*://jobs.ashbyhq.com/*",
        "*://jobs.lever.co/*",
        "*://jobs.eu.lever.co/*",
        "*://*.myworkdayjobs.com/*",
        "*://www.google.com/about/careers/*",
        "*://careers.google.com/*",
        "*://*.careers.microsoft.com/*",
        "*://jobs.smartrecruiters.com/*",
        "*://jobs.apple.com/*",
        "*://jobs.careers.microsoft.com/*",
        "*://www.tesla.com/careers/*",
        "*://www.atlassian.com/*",
        "*://wise.jobs/*",
        "*://careers.linkedin.com/*",
        "*://www.circle.com/careers/*",
        "*://www.hashicorp.com/careers/*",
        "*://retool.com/careers/*",
        "*://www.deel.com/careers/*",
        "*://jobs.deel.com/*",
        "*://bloomberg.avature.net/*",
        "*://ats.rippling.com/*",
        "*://*.lever.co/*",
        "*://*.ashbyhq.com/*",
        "*://*.workable.com/*",
        "*://*.jobvite.com/*",
        "*://*.icims.com/*",
        "*://*.bamboohr.com/*",
        "*://*.smartrecruiters.com/*",
        "*://*.paylocity.com/*",
        "*://*.dover.com/*",
        "*://*.rippling.com/*",
        "*://*.avature.net/*",
        "*://*.recruitee.com/*",
        "*://*.teamtailor.com/*",
        "*://*.breezy.hr/*",
        "*://*.pinpointhq.com/*",
        "*://*.gem.com/*",
        "*://*.eightfold.ai/*",
        "*://*.oraclecloud.com/*",
        "*://*.taleo.net/*",
        "*://*.successfactors.com/*",
        "*://*.workdayjobs.com/*",
        "*://careers.withwaymo.com/*",
        "*://www.workato.com/*"
      ],
      "js": [
        "page_gate.js",
        "form_agent.js",
        "agent_workflow.js",
        "stop_panel.js",
        "login_fill.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
